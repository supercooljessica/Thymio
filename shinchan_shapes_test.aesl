<!DOCTYPE aesl-source>
<network>
<keywords flag="true"/>
<node nodeId="1" name="thymio-II"><![CDATA[var cm = 214
var t90 = 1620
var seq[96] = [150, 150, 120, 150, -150, -100, 150, 150, 40, 150, -150, -100, 0, 150, -200, 150, -150, -100, 150, 150, 25, 150, -150, -100, 0, 150, -200, 150, -150, -100, 150, 150, 40, -150, 150, -50, -81, 150, -260, 150, -150, -150, -60, 150, -286, 150, -150, -170, -54, 150, -294, 150, -150, -80, -38, 150, -319, 150, -150, -150, -60, 150, -286, 150, -150, -130, -54, 150, -294, 150, 150, 120, 150, -150, -160, 150, 150, 120, 150, -150, -160, 150, 150, 120, 150, -150, -160, 150, 150, 120, 150, -150, -160, 150, 150, 120]
var i = 0
var e = 0
var d
var m

motor.left.target = 0
motor.right.target = 0
timer.period[0] = 0

sub go
motor.left.target = 0
motor.right.target = 0
timer.period[0] = 2000

onevent button.forward
i = 0
e = 33
call leds.top(32, 0, 32)
callsub go

onevent button.left
i = 33
e = 69
call leds.top(0, 20, 20)
callsub go

onevent button.right
i = 69
e = 96
call leds.top(32, 32, 0)
callsub go

onevent button.center
e = 0
callsub go

onevent timer0
if i < e then
	motor.left.target = seq[i]
	motor.right.target = seq[i + 1]
	d = seq[i + 2]
	if d > 0 then
		call math.muldiv(m, d, cm, 10)
	else
		d = -d
		call math.muldiv(m, d, t90, 100)
	end
	timer.period[0] = m
	i += 3
else
	motor.left.target = 0
	motor.right.target = 0
	timer.period[0] = 0
	call leds.top(0, 0, 0)
end
]]></node>
</network>
