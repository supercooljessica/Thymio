<!DOCTYPE aesl-source>
<network>
<keywords flag="true"/>
<node nodeId="1" name="thymio-II"><![CDATA[var cm = 214
var t90r = 1620
var t90l = 1620
var seq[141] = [150, 150, 30, 0, 0, 120, 150, 150, 60, 0, 0, 120, 150, 150, 120, 0, 0, 120, 300, 300, 60, 0, 0, 120, 150, -150, -20, 0, 0, 120, -150, -150, 30, 0, 0, 120, -150, -150, 60, 0, 0, 120, -150, -150, 120, 0, 0, 120, -300, -300, 60, 150, -150, -10, 0, 0, 60, 150, -150, -10, 0, 0, 60, 60, -60, -25, 0, 0, 60, 60, -60, -25, 0, 0, 60, 150, 150, 400, 0, 0, 60, -150, 150, -10, 0, 0, 60, -150, 150, -10, 0, 0, 60, -60, 60, -25, 0, 0, 60, -60, 60, -25, 60, 60, 94, 0, 0, 120, 60, 60, 187, 0, 0, 120, 60, 60, 374, 0, 0, 120, 150, -150, -20, 0, 0, 120, -60, -60, 94, 0, 0, 120, -60, -60, 187, 0, 0, 120, -60, -60, 374]
var i = 0
var e = 0
var d
var t
var m

motor.left.target = 0
motor.right.target = 0
timer.period[0] = 0

sub go
motor.left.target = 0
motor.right.target = 0
timer.period[0] = 2000

onevent button.forward
i = 0
e = 51
call leds.top(0, 32, 0)
callsub go

onevent button.left
i = 51
e = 102
call leds.top(0, 0, 32)
callsub go

onevent button.right
i = 102
e = 141
call leds.top(32, 0, 32)
callsub go

onevent button.center
e = 0
callsub go

onevent timer0
if i < e then
	motor.left.target = seq[i]
	motor.right.target = seq[i + 1]
	d = seq[i + 2]
	t = cm
	if d < 0 then
		d = -d
		t = t90l
		if seq[i] > seq[i + 1] then
			t = t90r
		end
	end
	call math.muldiv(m, d, t, 10)
	timer.period[0] = m
	i += 3
else
	motor.left.target = 0
	motor.right.target = 0
	timer.period[0] = 0
	call leds.top(0, 0, 0)
end
]]></node>
</network>
