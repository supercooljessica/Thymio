<!DOCTYPE aesl-source>
<network>


<!--list of global events-->


<!--list of constants-->


<!--show keywords state-->
<keywords flag="true"/>


<!--node thymio-II-->
<node nodeId="1" name="thymio-II"># green = wander
# yellow = maneuver
# cyan = draw
# red = avoid
# orange = blocked between escape attempts
# blue = paused

# constant values for parameters
var obstacle_threshold = 1500	# maneuver around
var hard_threshold = 3000     # immediate avoid
var clear_threshold = 900
var fast_rise = 800
var maneuver_fast_rise = 1400  # stronger rise required while turning
var white_min = 500
var edge_samples = 10       # normal edge debounce
var fast_edge_samples = 2   # faster stop during high-speed escape
var wander_speed = 100
var wander_curve = 60       # steering that makes wandering curvy
var rear_caution_speed = 140
var maneuver_speed = 60
var maneuver_steer = 90
var maneuver_timeout_ticks = 30
var wander_ticks_to_draw = 120
var pen_speed = 900
var pen_side = -20
var pen_turn = -953
var drawing_steps[51] = [31, -7663, 1057, 44, 372, 745, 49, 5177, 669, 62, 24840, 529, 44, -32396, 745, 49, -20892, 669, 83, -16384, 0, 28, -32768, 0, 52, 16542, 315, 17, 16384, 0, 52, 158, 315, 28, 0, 0, 83, -16384, 0, 83, 22938, 0, 83, -3277, 0, 83, -29491, 0, 83, 9830, 0]  # cloud, underpants, star
var shiver_speed = 300
var shiver_interval_ms = 50
var shiver_intervals = 25
var turn_180_ms = 1200   # at speed 500
var turn_90_ms = 600     # at speed 500
var shot_time = 1000
var shot_speed = 500

# measured values
var state = 1	# 1=wander; 2=draw, 3=avoid
var paused = 0
var seen_prox = 0
var wander_ticks = 0
var wander_sign = 1
var maneuver_active = 0
var maneuver_ticks = 0
var maneuver_side = 1
var drive_speed = 0
var steer = 0
var space_steer = 0         # steering away from nearby things, without the curve
var left_space = 0
var right_space = 0
var front_peak = 0
var rear_peak = 0
var front_history[3] = [0, 0, 0]  # newest reading first
var rear_history[3] = [0, 0, 0]
var front_rise = 0
var rear_rise = 0
var front_fast_hits = 0
var rear_fast_hits = 0
var ground_low[2] = [0, 0]  # left, right consecutive low readings
var edge_confirmed = 0
var edge_fast = 0
var clear_samples = 0
var drawing_index = 0
var drawing_end = 0
var next_drawing = 0
var step_count = 0
var pause_count = 0
var pen_dir = 0
var pen_dir_step = 0
var heading = 0
var heading_rest = 0
var left_rest = 0
var right_rest = 0
var angle = 0
var sin_angle = 0
var cos_angle = 0
var forward_part = 0
var side_part = 0
var turn_part = 0
var left_speed = 0
var right_speed = 0
var avoid_kind = 0         # 1 front: 180, 2 rear: 0, 3 blocked front: 90
var avoid_phase = 0        # 1 shiver, 2 turn, 3 shot, 4 blocked
var shiver_index = 0

# setup
timer.period[0] = 100
timer.period[1] = 0
motor.left.target = 0
motor.right.target = 0
call leds.top(0, 32, 0)


sub drive_to_empty_space # set wandering speeds, avoid obstacles that are relatively stationary
if seen_prox == 1 and front_peak &lt; hard_threshold and rear_peak &lt; hard_threshold and edge_confirmed == 0 then
	left_space = prox.horizontal[0] + prox.horizontal[1]
	right_space = prox.horizontal[3] + prox.horizontal[4]
	if maneuver_active == 1 then
		# follow the side picked when maneuvering started
		drive_speed = maneuver_speed
		steer = maneuver_side * maneuver_steer
	else
		# wander away from whichever front side sees more reflection
		drive_speed = wander_speed
		if rear_peak >= obstacle_threshold then
			drive_speed = rear_caution_speed
		end
		space_steer = (right_space - left_space) / 20
		steer = space_steer + wander_sign * wander_curve
		if steer > 120 then
			steer = 120
		elseif steer &lt; -120 then
			steer = -120
		end
	end
	motor.left.target = drive_speed - steer
	motor.right.target = drive_speed + steer
else
	motor.left.target = 0
	motor.right.target = 0
end


sub resume_wander # reset wander clock and sensor history
timer.period[1] = 0
state = 1 # wander
avoid_phase = 0
wander_ticks = 0
wander_sign = 1
maneuver_active = 0
maneuver_ticks = 0
call math.fill(front_history, front_peak)
call math.fill(rear_history, rear_peak)
front_fast_hits = 0
rear_fast_hits = 0
call leds.top(0, 32, 0)
callsub drive_to_empty_space


sub start_maneuver # slower speed to navigate around an obstacle
if state == 2 then # draw
	timer.period[1] = 0
	wander_ticks = 0
end
state = 1 # wander
maneuver_active = 1
maneuver_ticks = 0
clear_samples = 0
left_space = prox.horizontal[0] + prox.horizontal[1]
right_space = prox.horizontal[3] + prox.horizontal[4]
# pick the less occupied side, or use the wander direction if it is close
if right_space > left_space + 200 then
	maneuver_side = 1
elseif left_space > right_space + 200 then
	maneuver_side = -1
else
	maneuver_side = wander_sign
end
call leds.top(20, 20, 0)
callsub drive_to_empty_space

sub finish_maneuver # reset values, return to normal wandering
maneuver_active = 0
maneuver_ticks = 0
clear_samples = 0
call leds.top(0, 32, 0)
callsub drive_to_empty_space

sub block_motion # stop when an escape path is blocked, then retry when there is room
timer.period[1] = 0
motor.left.target = 0
motor.right.target = 0
if state == 3 and avoid_phase != 4 then
	avoid_kind = 3
end
state = 3
avoid_phase = 4
clear_samples = 0
maneuver_active = 0
call leds.top(32, 12, 0)

sub start_avoid # if edge or fast obstacle detected
timer.period[1] = 0
state = 3
maneuver_active = 0
avoid_phase = 1
shiver_index = 0
call leds.top(32, 0, 0)
callsub start_shiver_interval

sub start_shiver_interval # alternate which wheel moves, then reverse both targets for front escapes
if shiver_index % 2 == 0 then
	motor.left.target = shiver_speed * 2
	motor.right.target = 0
else
	motor.left.target = 0
	motor.right.target = shiver_speed * 2
end
if avoid_kind != 2 then
	motor.left.target = -motor.left.target
	motor.right.target = -motor.right.target
end
timer.period[1] = shiver_interval_ms


sub start_shot # run away quickly
if front_peak >= clear_threshold or edge_fast == 1 then
	callsub block_motion
else
	avoid_phase = 3
	motor.left.target = shot_speed
	motor.right.target = shot_speed
	timer.period[1] = shot_time
end

sub start_drawing # start drawing
timer.period[1] = 0
motor.left.target = 0
motor.right.target = 0
state = 2
drawing_index = next_drawing
drawing_end = next_drawing + 18
if drawing_end > 51 then
	drawing_end = 51
end
next_drawing = drawing_end % 51
step_count = 0
pause_count = 6
heading = 0
heading_rest = 0
left_rest = 0
right_rest = 0
maneuver_active = 0
call leds.top(0, 20, 20)
timer.period[1] = 50

sub drawing_step
if step_count > 0 then
	angle = pen_dir - heading
	call math.sin(sin_angle, angle)
	call math.cos(cos_angle, angle)
	call math.muldiv(forward_part, cos_angle, pen_speed, 32767)
	call math.muldiv(side_part, sin_angle, pen_side, 32767)
	forward_part += side_part
	call math.muldiv(turn_part, sin_angle, pen_turn, 32767)
	left_rest += forward_part - turn_part
	right_rest += forward_part + turn_part
	left_speed = left_rest / 10
	right_speed = right_rest / 10
	left_rest -= left_speed * 10
	right_rest -= right_speed * 10
	motor.left.target = left_speed
	motor.right.target = right_speed
	heading_rest += (right_speed - left_speed) * 86
	turn_part = heading_rest / 49
	heading += turn_part
	heading_rest -= turn_part * 49
	pen_dir += pen_dir_step
	step_count -= 1
	timer.period[1] = 50
elseif pause_count > 0 then
	motor.left.target = 0
	motor.right.target = 0
	pause_count -= 1
	timer.period[1] = 50
elseif drawing_index &lt; drawing_end then
	step_count = drawing_steps[drawing_index]
	pen_dir = drawing_steps[drawing_index + 1]
	pen_dir_step = drawing_steps[drawing_index + 2]
	drawing_index += 3
	pause_count = 6
	timer.period[1] = 50
else
	callsub resume_wander
end

onevent button.center # pause and play
if button.center == 1 then
	if paused == 0 then
		paused = 1
		timer.period[1] = 0
		motor.left.target = 0
		motor.right.target = 0
		call leds.top(0, 0, 32)
	else
		paused = 0
		# resume carefully if a hazard is still nearby
		if front_peak >= hard_threshold or rear_peak >= hard_threshold or edge_confirmed == 1 or (front_peak >= obstacle_threshold and rear_peak >= obstacle_threshold) then
			if state != 3 then
				if front_peak >= clear_threshold or edge_confirmed == 1 then
					avoid_kind = 1
				else
					avoid_kind = 2
				end
			end
			callsub block_motion
		else
			callsub resume_wander
			if front_peak >= obstacle_threshold then
				callsub start_maneuver
			end
		end
	end
end


########
# MAIN
########

onevent prox

# get the strongest front and rear reflections
call math.stat(prox.horizontal[0:4], left_space, front_peak, right_space)
call math.max(rear_peak, prox.horizontal[5:5], prox.horizontal[6:6])

# see if an obstacle is getting closer quickly
if seen_prox == 0 then
	front_rise = 0
	rear_rise = 0
	call math.fill(front_history, front_peak)
	call math.fill(rear_history, rear_peak)
	seen_prox = 1
else
	front_rise = front_peak - front_history[2]
	rear_rise = rear_peak - rear_history[2]
	front_history[2] = front_history[1]
	front_history[1] = front_history[0]
	front_history[0] = front_peak
	rear_history[2] = rear_history[1]
	rear_history[1] = rear_history[0]
	rear_history[0] = rear_peak
end

# count rapid front approaches for avoid
if state == 1 and (maneuver_active == 1 or (space_steer > -30 and space_steer &lt; 30)) and front_peak >= obstacle_threshold then # wander
	if (maneuver_active == 0 and front_rise >= fast_rise) or (maneuver_active == 1 and front_rise >= maneuver_fast_rise) then
		if front_fast_hits &lt; 2 then
			front_fast_hits += 1
		end
	else
		front_fast_hits = 0
	end
else
	front_fast_hits = 0
end
# count rapid rear approaches only while not steering hard away from something
if state == 1 and maneuver_active == 0 and space_steer > -30 and space_steer &lt; 30 and rear_peak >= obstacle_threshold and rear_rise >= fast_rise then
	if rear_fast_hits &lt; 2 then
		rear_fast_hits += 1
	end
else
	rear_fast_hits = 0
end

# edge detection with sampling
if prox.ground.delta[0] &lt;= white_min then
	if ground_low[0] &lt; edge_samples then
		ground_low[0] += 1
	end
else
	ground_low[0] = 0
end
if prox.ground.delta[1] &lt;= white_min then
	if ground_low[1] &lt; edge_samples then
		ground_low[1] += 1
	end
else
	ground_low[1] = 0
end
edge_confirmed = 0
edge_fast = 0
if ground_low[0] >= edge_samples or ground_low[1] >= edge_samples then
	edge_confirmed = 1
end
if ground_low[0] >= fast_edge_samples or ground_low[1] >= fast_edge_samples then
	edge_fast = 1
end

if paused == 0 then
	if state == 3 then
		# keep the current escape safe before considering a new action
		if avoid_phase == 4 then
			# retry a blocked front escape when there is room behind
			if front_peak >= clear_threshold or edge_fast == 1 then
				clear_samples = 0
				if rear_peak &lt; obstacle_threshold then
					if avoid_kind != 1 then
						avoid_kind = 3
					end
					callsub start_avoid
				end
			elseif rear_peak >= obstacle_threshold then
				clear_samples = 0
				avoid_kind = 2
				callsub start_avoid
			else
				clear_samples += 1
				if clear_samples >= 3 then
					callsub resume_wander
				end
			end
		elseif avoid_phase == 1 then
			# stop shivering if the travel direction becomes blocked
			if (avoid_kind != 2 and rear_peak >= obstacle_threshold) or (avoid_kind == 2 and (front_peak >= obstacle_threshold or edge_fast == 1)) then
				callsub block_motion
			end
		elseif avoid_phase == 2 then
				# stop turning if a ground edge appears
			if edge_fast == 1 then
				callsub block_motion
			end
		elseif avoid_phase == 3 then
			# stop the forward shot if another front obstacle or edge appears
			if front_peak >= obstacle_threshold or edge_fast == 1 then
				callsub block_motion
			end
		end
	elseif edge_confirmed == 1 or front_peak >= hard_threshold or front_fast_hits >= 2 then
		# a new front or edge hazard gets the 180 turn escape
		avoid_kind = 1
		if rear_peak >= obstacle_threshold then
			callsub block_motion
		else
			callsub start_avoid
		end
	elseif rear_peak >= hard_threshold or rear_fast_hits >= 2 then
		# a rear hazard gets a forward shiver and no turn
		avoid_kind = 2
		if front_peak >= clear_threshold or edge_fast == 1 then
			callsub block_motion
		else
			callsub start_avoid
		end
	elseif front_peak >= obstacle_threshold or maneuver_active == 1 then
		# try steering around a slower front obstacle before escaping
		if maneuver_active == 0 then
			callsub start_maneuver
		else
			if front_peak &lt; clear_threshold then
				clear_samples += 1
				if clear_samples >= 3 then
					callsub finish_maneuver
				end
			else
				clear_samples = 0
			end
			if maneuver_active == 1 then
				callsub drive_to_empty_space
			end
		end
	elseif state == 1 then
		callsub drive_to_empty_space
	end
end

onevent timer0 # keep time for wandering and maneuvering
if paused == 0 and state == 1 and seen_prox == 1 then
	wander_ticks += 1
	# flip the curve every three seconds
	if wander_ticks % 30 == 0 then
		wander_sign = -wander_sign
	end
	if maneuver_active == 1 then
		# give up maneuvering after three seconds if the front is still blocked
		maneuver_ticks += 1
		if maneuver_ticks >= maneuver_timeout_ticks then
			if front_peak &lt; obstacle_threshold then
				callsub finish_maneuver
			elseif rear_peak >= obstacle_threshold then
				avoid_kind = 1
				callsub block_motion
			else
				avoid_kind = 1
				callsub start_avoid
			end
		end
	elseif wander_ticks >= wander_ticks_to_draw and front_peak &lt; obstacle_threshold and rear_peak &lt; obstacle_threshold and edge_fast == 0 then
		# start drawing after twelve seconds with a clear path
		callsub start_drawing
	end
end

onevent timer1 # move to the next timed motion
timer.period[1] = 0
if paused == 0 then
	if state == 2 then
		callsub drawing_step
	elseif state == 3 then
		if avoid_phase == 1 then
			# repeat the shiver intervals, then choose the turn for this escape
			shiver_index += 1
			if shiver_index &lt; shiver_intervals then
				callsub start_shiver_interval
			elseif avoid_kind != 2 then
				if rear_peak >= obstacle_threshold or edge_confirmed == 1 then
					callsub block_motion
				else
					avoid_phase = 2
					if avoid_kind == 1 then
						motor.left.target = 500
						motor.right.target = -500
						timer.period[1] = turn_180_ms
					else
						# for blocked retries, turn 90 toward the less occupied side
						left_space = prox.horizontal[0] + prox.horizontal[1]
						right_space = prox.horizontal[3] + prox.horizontal[4]
						if right_space >= left_space then
							maneuver_side = 1
						else
							maneuver_side = -1
						end
						motor.left.target = -maneuver_side * 500
						motor.right.target = maneuver_side * 500
						timer.period[1] = turn_90_ms
					end
				end
			else
				callsub start_shot
			end
		elseif avoid_phase == 2 then
			# turn finished, so try the forward shot
			callsub start_shot
		elseif avoid_phase == 3 then
			# shot finished, so return to wandering if the path is clear
			if front_peak >= clear_threshold or rear_peak >= clear_threshold or edge_fast == 1 then
				callsub block_motion
			else
				callsub resume_wander
			end
		end
	end
end
</node>


</network>
