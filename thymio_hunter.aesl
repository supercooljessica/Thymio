<!DOCTYPE aesl-source>
<network>


<!--list of global events-->


<!--list of constants-->


<!--show keywords state-->
<keywords flag="true"/>


<!--node thymio-II-->
<node nodeId="31202" name="thymio-II"># Thymio II hunter: paste the complete file into Aseba Studio.
# 0 SEARCH blue; 1 PURSUE green; 2 RECOVER yellow;
# 3 TAUNT magenta; 4 AVOID red.
# Control runs on fresh IR readings (10 Hz). Durations below are 100 ms ticks.
# IR thresholds are NOT millimetres. Calibrate with the actual other robot.
# Front 0..4 = left..right; rear 5 = left, 6 = right.
# No robot identification, true velocity measurement, or side-facing sensors.
# Test on a clear, level floor; no cliff detection is included.

# ---------- Settings ----------
var detect_threshold = 700
var retain_threshold = 500
var close_threshold = 2500   # Calibrate at a 50 mm body-to-body gap
var warning_threshold = 2800
var hard_threshold = 4800    # Immediate override at ANY sensor
var flank_threshold = 3600
var rise_threshold = 350     # Raw IR increase per fresh sample
var lateral_tolerance = 35   # Bearing change allowed before treating as crossing
var avoid_clear_threshold = 2200  # Release AVOID before every wall leaves sensor range
var rear_clear_threshold = 900
var nudge_threshold = 2100
var search_speed = 220
var pursue_speed = 330
var recover_speed = 180
var avoid_spin_speed = 150
var reverse_speed = 300
var spin_speed = 400
var escape_speed = 300
var full_scan_ticks = 30     # Calibrate for ~360 degrees at search_turn_speed
var quarter_turn_ticks = 8   # Calibrate for ~90 degrees at search_turn_speed
var search_turn_speed = 250
var leg_ticks = 14           # First spiral leg: roughly 10-15 cm; calibrate
var turn_ticks = 10          # Calibrate for ~180 degrees at spin_speed

# ---------- Working variables ----------
var state = 0
var phase = 0
var age = 0
var leg = 1
var leg_pair = 0
var last_side = 1
var front_seen = 0
var rear_seen = 0
var rear_clear = 0
var clear_count = 0
var samples = 0
var stale_ticks = 0
var previous_state = -1
var previous_bearing = 0
var previous_peak_index = 2
var r[7] = [0,0,0,0,0,0,0]
var old[7] = [0,0,0,0,0,0,0]
var delta[7] = [0,0,0,0,0,0,0]
var i = 0
var first = 0
var last = 0
var peak = 0
var peak_index = 2
var nose = 0
var rear = 0
var left_load = 0
var right_load = 0
var total = 0
var weighted = 0
var q = 0
var bearing = 0
var bearing_change = 0
var bearing_abs = 0
var change_abs = 0
var turn = 0
var drive = 0
var left_cmd = 0
var right_cmd = 0
var hazard = 0
var rear_threat = 0
var all_blocked = 0
var all_hard = 0
var all_clear = 0
var coherent_rise = 0

motor.left.target = 0
motor.right.target = 0
timer.period[0] = 100
timer.period[1] = 0
call leds.top(0,0,32)

# Timer is only a watchdog; it never reuses old readings to drive.
onevent timer0
if stale_ticks &lt; 10 then
    stale_ticks += 1
end
if stale_ticks >= 3 then
    motor.left.target = 0
    motor.right.target = 0
    state = 0
    phase = 0
    age = 0
    samples = 0
    front_seen = 0
    rear_seen = 0
    previous_state = -1
end

onevent prox
stale_ticks = 0
peak = 0
peak_index = 2
hazard = 0
rear_threat = 0
all_blocked = 1
all_hard = 1
all_clear = 1
for i in 0:6 do
    # Cap only for overflow protection; ordinary readings are much smaller.
    r[i] = prox.horizontal[i]
    if r[i] > 8000 then
        r[i] = 8000
    end
    delta[i] = 0
    if samples > 0 then
        delta[i] = r[i] - old[i]
    end
    old[i] = r[i]
    if r[i] >= hard_threshold then
        hazard = 1
        if i >= 5 then
            rear_threat = 1
        end
    else
        all_hard = 0
    end
    if r[i] &lt; detect_threshold then
        all_blocked = 0
    end
    if r[i] >= avoid_clear_threshold then
        all_clear = 0
    end
    if i &lt; 5 then
        if r[i] > peak then
            peak = r[i]
            peak_index = i
        end
    end
end
samples = 1
nose = r[1]
if r[2] > nose then
    nose = r[2]
end
if r[3] > nose then
    nose = r[3]
end
rear = r[5]
if r[6] > rear then
    rear = r[6]
end
left_load = r[0] + r[1] + r[5]
right_load = r[3] + r[4] + r[6]

# Follow one local cluster, rather than averaging two separated objects.
first = peak_index - 1
last = peak_index + 1
if first &lt; 0 then
    first = 0
end
if last > 4 then
    last = 4
end
total = 0
weighted = 0
for i in 0:4 do
    if i >= first and i &lt;= last and r[i] >= retain_threshold then
        q = r[i] / 32
        total += q
        weighted += (i - 2) * q
    end
end
bearing = 0
if total > 0 then
    call math.muldiv(bearing, weighted, 100, total)
end
bearing_abs = abs bearing
bearing_change = 0
# Only differentiate consecutive observations of a similar front cluster.
if previous_state == state and peak >= retain_threshold and front_seen > 0 then
    if peak_index >= previous_peak_index - 1 and peak_index &lt;= previous_peak_index + 1 then
        bearing_change = bearing - previous_bearing
    end
end
change_abs = abs bearing_change
previous_bearing = bearing
previous_peak_index = peak_index

if peak >= retain_threshold then
    if front_seen &lt; 2 then
        front_seen += 1
    end
    if bearing &lt; -10 then
        last_side = -1
    elseif bearing > 10 then
        last_side = 1
    end
else
    front_seen = 0
end
if rear >= detect_threshold then
    if rear_seen &lt; 2 then
        rear_seen += 1
    end
else
    rear_seen = 0
end
if rear &lt; rear_clear_threshold then
    if rear_clear &lt; 2 then
        rear_clear += 1
    end
else
    rear_clear = 0
end

# Early frontal warning: TWO adjacent central beams must be rising.
# A rapid bearing change relaxes only this early warning, never hard clearance.
coherent_rise = 0
if delta[1] > rise_threshold and delta[2] > rise_threshold then
    coherent_rise = 1
end
if delta[2] > rise_threshold and delta[3] > rise_threshold then
    coherent_rise = 1
end
if nose >= warning_threshold and coherent_rise == 1 and change_abs &lt;= lateral_tolerance then
    hazard = 1
end
# Independently watch outer-front and rear beams for approaching obstacles.
for i in 0:6 do
    if i == 0 or i >= 4 then
        if r[i] >= flank_threshold and delta[i] > rise_threshold then
            hazard = 1
            if i >= 5 then
                rear_threat = 1
            end
        end
    end
end
# A hard front/rear translation margin, regardless of measured closing rate.
if motor.left.target + motor.right.target > 0 and nose >= hard_threshold - 400 then
    hazard = 1
end
if motor.left.target + motor.right.target &lt; 0 and rear >= retain_threshold then
    hazard = 1
    rear_threat = 1
end

# Avoidance preempts search, pursuit, recovery, and EVERY taunt phase.
if hazard == 1 and state != 4 then
    state = 4
    phase = 0
    age = 0
    clear_count = 0
end
# Rear danger gets a latched FORWARD escape when the front gap is open.
# Do not restart its age on every sample of the same rear threat.
if state == 4 and phase != 2 and rear_threat == 1 and nose &lt; avoid_clear_threshold and r[0] &lt; flank_threshold and r[4] &lt; flank_threshold then
    phase = 2
    age = 0
    clear_count = 0
end
previous_state = state
drive = 0
turn = 0
age += 1

if state == 0 then
    call leds.top(0,0,32)
    if front_seen >= 2 and peak >= detect_threshold then
        state = 1
        age = 0
    elseif rear_seen >= 2 then
        state = 2
        age = 0
        last_side = 1
        if r[5] > r[6] then
            last_side = -1
        end
    else
        # Full initial scan, then an expanding square spiral.
        # Leg lengths: 1,1,2,2,...6,6; then restart the pattern at this location.
        if phase == 0 then
            turn = search_turn_speed
            if age >= full_scan_ticks then
                phase = 1
                age = 0
            end
        elseif phase == 1 then
            drive = search_speed
            if age >= leg * leg_ticks then
                phase = 2
                age = 0
                drive = 0
            end
        else
            turn = search_turn_speed
            if age >= quarter_turn_ticks then
                phase = 1
                age = 0
                leg_pair += 1
                if leg_pair >= 2 then
                    leg_pair = 0
                    leg += 1
                end
                if leg > 6 then
                    leg = 1
                    phase = 0
                end
            end
        end
    end

elseif state == 1 then
    call leds.top(0,32,0)
    if front_seen == 0 then
        state = 2
        age = 0
    elseif r[2] >= close_threshold and bearing_abs &lt; 65 then
        state = 3
        phase = 0
        age = 0
    else
        # PD-like steering: follow position plus recent angular drift.
        turn = bearing + bearing_change / 2
        if turn > 280 then
            turn = 280
        elseif turn &lt; -280 then
            turn = -280
        end
        # Fast at range; brake as the gap shrinks or steering gets large.
        drive = (close_threshold - nose) / 5 - bearing_abs / 2
        if drive > pursue_speed then
            drive = pursue_speed
        elseif drive &lt; 0 then
            drive = 0
        end
    end

elseif state == 2 then
    call leds.top(32,24,0)
    if front_seen >= 2 then
        state = 1
        age = 0
    elseif age >= 35 then
        callsub reset_search
    else
        turn = last_side * recover_speed
        if age >= 14 then
            turn = -turn
        end
    end

elseif state == 3 then
    call leds.top(32,0,32)
    if phase == 0 then
        # Stop for one second; the collision supervisor remains active.
        if age >= 10 then
            phase = 1
            age = 0
            turn = spin_speed
        end
    elseif phase == 1 then
        turn = spin_speed
        if age >= turn_ticks then
            phase = 2
            age = 0
            turn = 0
            drive = escape_speed
        end
    else
        drive = escape_speed
        # Limit forward escape speed if a new obstacle is ahead.
        if nose >= warning_threshold then
            drive = (hard_threshold - 400 - nose) / 5
            if drive &lt; 0 then
                drive = 0
            end
        end
        if age >= 20 then
            callsub reset_search
            drive = 0
        end
    end

else
    # AVOID phases: 0 find an exit; 1 reverse; 2 move through a clear front gap.
    call leds.top(32,0,0)
    if all_clear == 1 then
        clear_count += 1
    else
        clear_count = 0
    end
    if phase == 2 then
        # Move forward only while the central path and both flanks stay open.
        if nose >= avoid_clear_threshold or r[0] >= flank_threshold or r[4] >= flank_threshold then
            # Stop now; reassess an alternative exit next sample.
            phase = 0
            age = 0
        elseif clear_count >= 3 and age >= 5 then
            callsub reset_search
        else
            drive = search_speed
            if age >= 300 then
                age = 5
            end
        end
    elseif phase == 1 then
        # Recheck the rear EVERY sample, including while backing out.
        if rear >= rear_clear_threshold or age >= 12 then
            phase = 0
            age = 0
            rear_clear = 0
        elseif clear_count >= 3 and age >= 5 then
            callsub reset_search
        else
            drive = -reverse_speed
        end
    else
        if clear_count >= 3 and age >= 5 then
            callsub reset_search
        elseif rear_clear >= 2 then
            phase = 1
            age = 0
            drive = -reverse_speed
        elseif nose &lt; avoid_clear_threshold and r[0] &lt; flank_threshold and r[4] &lt; flank_threshold then
            # A nearby wall behind us should not trap us in a stationary spin.
            phase = 2
            age = 0
            drive = search_speed
        else
            # Turn toward the less obstructed sensed side.
            turn = avoid_spin_speed
            if left_load &lt; right_load then
                turn = -avoid_spin_speed
            end
            if all_blocked == 1 then
                # One 100 ms low-speed nudge, then two samples reassessing.
                # Use only a relatively open, non-closing front/rear sector.
                if age % 3 == 0 then
                    if nose &lt; rear and nose &lt; nudge_threshold and r[0] &lt; nudge_threshold and r[4] &lt; nudge_threshold then
                        if delta[1] &lt;= 0 and delta[2] &lt;= 0 and delta[3] &lt;= 0 then
                            drive = 50
                            turn = 0
                        end
                    elseif rear &lt; nose and rear &lt; nudge_threshold then
                        if delta[5] &lt;= 0 and delta[6] &lt;= 0 then
                            drive = -50
                            turn = 0
                        end
                    end
                end
            end
            # If completely boxed in at critical distance, do not force a move.
            if all_hard == 1 then
                drive = 0
                turn = 0
            end
            if age >= 300 then
                age = 0
            end
        end
    end
end

# Translation plus steering; positive turn is clockwise.
left_cmd = drive + turn
right_cmd = drive - turn
if left_cmd > 500 then
    left_cmd = 500
elseif left_cmd &lt; -500 then
    left_cmd = -500
end
if right_cmd > 500 then
    right_cmd = 500
elseif right_cmd &lt; -500 then
    right_cmd = -500
end
motor.left.target = left_cmd
motor.right.target = right_cmd

sub reset_search
state = 0
phase = 0
age = 0
leg = 1
leg_pair = 0
front_seen = 0
rear_seen = 0
clear_count = 0
</node>


</network>
