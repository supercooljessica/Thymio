<!DOCTYPE aesl-source>
<network>
<keywords flag="true"/>
<node nodeId="31202" name="thymio-II"><![CDATA[
# Shin-chan Shy: explore open space for 8 seconds, then draw a cloud.
# A nearby, slow-changing front reading gets a three-second maneuver first.
# A rapid rise, very close object, failed maneuver, or edge triggers escape.
# A slow rear approach speeds exploration up; a fast/close one runs forward.
# Centre button pauses/resumes. Green=explore, yellow=maneuver,
# cyan=draw, red=avoid, orange=blocked, blue=paused.

var front_threshold = 1500  # start maneuvering
var front_hard = 3000       # escape immediately
var front_clear = 900
var rear_threshold = 1500   # move away gently
var rear_hard = 3000        # escape immediately
var rear_clear = 900
var fast_rise = 800         # raw proximity rise across about 3 sensor updates
var maneuver_fast_rise = 1400  # stronger rise required while turning
var white_min = 500
var edge_samples = 10       # normal edge debounce, from the edge test
var fast_edge_samples = 2   # faster stop during high-speed escape
var explore_speed = 100
var rear_caution_speed = 140
var maneuver_speed = 60
var maneuver_steer = 90
var maneuver_timeout_ticks = 30  # 3 seconds at 100 ms per timer0 event
var explore_ticks_to_draw = 80  # timer0 is 100 ms, so 80 ticks = 8 seconds

var pen_speed = 900
var pen_side = -20
var pen_turn = -953
var cloud_steps[18] = [31, -7663, 1057, 44, 372, 745, 49, 5177, 669, 62, 24840, 529, 44, -32396, 745, 49, -20892, 669]

var wiggle_speed = 300
var swerve_magnitude = 300
var wiggle_step_time = 50
var wiggle_steps = 25
var turn_time = 1200       # 180 degrees at 500, -500; tune on the robot
var shot_time = 1000
var shot_speed = 500

var state = 1              # 1 explore, 2 draw, 3 avoid
var paused = 0
var seen_prox = 0
var explore_ticks = 0
var wander_sign = 1
var maneuver_active = 0
var maneuver_ticks = 0
var maneuver_clear_samples = 0
var maneuver_side = 1
var drive_speed = 0
var steer = 0
var left_space = 0
var right_space = 0
var front_peak = 0
var rear_peak = 0
var front_min = 0
var front_mean = 0
var front_prev_1 = 0
var front_prev_2 = 0
var front_prev_3 = 0
var rear_prev_1 = 0
var rear_prev_2 = 0
var rear_prev_3 = 0
var trend_ready = 0
var front_rise = 0
var rear_rise = 0
var front_fast_hits = 0
var rear_fast_hits = 0
var left_low = 0
var right_low = 0
var edge_confirmed = 0
var edge_fast = 0
var clear_samples = 0

var cloud_index = 0
var step_count = 0
var pause_count = 0
var pen_dir = 0
var pen_dir_step = 0
var heading = 0
var heading_rest = 0
var left_rest = 0
var right_rest = 0
var angle = 0
var sin_angle = 0
var cos_angle = 0
var forward_part = 0
var side_part = 0
var turn_part = 0
var left_speed = 0
var right_speed = 0

var avoid_kind = 0         # 1 front/edge, 2 rear
var avoid_phase = 0        # 1 wiggle, 2 turn, 3 shot, 4 blocked
var wiggle_index = 0
var wiggle_left = 0
var wiggle_right = 0

timer.period[0] = 100
timer.period[1] = 0
motor.left.target = 0
motor.right.target = 0
call leds.top(0, 32, 0)

sub drive_to_empty_space
if seen_prox == 1 and front_peak < front_hard and rear_peak < rear_hard and edge_confirmed == 0 then
	left_space = prox.horizontal[0] + prox.horizontal[1]
	right_space = prox.horizontal[3] + prox.horizontal[4]
	if maneuver_active == 1 then
		drive_speed = maneuver_speed
		steer = maneuver_side * maneuver_steer
	else
		drive_speed = explore_speed
		if rear_peak >= rear_threshold then
			drive_speed = rear_caution_speed
		end
		# More reflection on the right means more empty space on the left.
		steer = (right_space - left_space) / 20 + wander_sign * 20
		if steer > 80 then
			steer = 80
		elseif steer < -80 then
			steer = -80
		end
	end
	motor.left.target = drive_speed - steer
	motor.right.target = drive_speed + steer
else
	motor.left.target = 0
	motor.right.target = 0
end

sub resume_explore
timer.period[1] = 0
state = 1
avoid_phase = 0
explore_ticks = 0
wander_sign = 1
maneuver_active = 0
maneuver_ticks = 0
front_prev_1 = front_peak
front_prev_2 = front_peak
front_prev_3 = front_peak
rear_prev_1 = rear_peak
rear_prev_2 = rear_peak
rear_prev_3 = rear_peak
trend_ready = 1
front_fast_hits = 0
rear_fast_hits = 0
call leds.top(0, 32, 0)
callsub drive_to_empty_space

sub start_maneuver
if state == 2 then
	timer.period[1] = 0
	explore_ticks = 0
end
state = 1
maneuver_active = 1
maneuver_ticks = 0
maneuver_clear_samples = 0
left_space = prox.horizontal[0] + prox.horizontal[1]
right_space = prox.horizontal[3] + prox.horizontal[4]
if right_space > left_space + 200 then
	maneuver_side = 1
elseif left_space > right_space + 200 then
	maneuver_side = -1
else
	maneuver_side = wander_sign
end
call leds.top(20, 20, 0)
callsub drive_to_empty_space

sub finish_maneuver
maneuver_active = 0
maneuver_ticks = 0
maneuver_clear_samples = 0
call leds.top(0, 32, 0)
callsub drive_to_empty_space

sub block_motion
timer.period[1] = 0
motor.left.target = 0
motor.right.target = 0
state = 3
avoid_phase = 4
clear_samples = 0
maneuver_active = 0
call leds.top(32, 12, 0)

sub start_wiggle_step
if wiggle_index % 2 == 0 then
	wiggle_left = wiggle_speed + swerve_magnitude
	wiggle_right = wiggle_speed - swerve_magnitude
else
	wiggle_left = wiggle_speed - swerve_magnitude
	wiggle_right = wiggle_speed + swerve_magnitude
end
if avoid_kind == 1 then
	wiggle_left = -wiggle_left
	wiggle_right = -wiggle_right
end
# Keep target speeds in the Thymio motor range.
if wiggle_left > 500 then
	wiggle_left = 500
elseif wiggle_left < -500 then
	wiggle_left = -500
end
if wiggle_right > 500 then
	wiggle_right = 500
elseif wiggle_right < -500 then
	wiggle_right = -500
end
motor.left.target = wiggle_left
motor.right.target = wiggle_right
timer.period[1] = wiggle_step_time

sub start_avoid
timer.period[1] = 0
state = 3
maneuver_active = 0
avoid_phase = 1
wiggle_index = 0
call leds.top(32, 0, 0)
callsub start_wiggle_step

sub start_shot
if front_peak >= front_clear or edge_fast == 1 then
	callsub block_motion
else
	avoid_phase = 3
	motor.left.target = shot_speed
	motor.right.target = shot_speed
	timer.period[1] = shot_time
end

sub start_cloud
timer.period[1] = 0
motor.left.target = 0
motor.right.target = 0
state = 2
cloud_index = 0
step_count = 0
pause_count = 6
heading = 0
heading_rest = 0
left_rest = 0
right_rest = 0
maneuver_active = 0
call leds.top(0, 20, 20)
timer.period[1] = 50

sub cloud_step
if step_count > 0 then
	angle = pen_dir - heading
	call math.sin(sin_angle, angle)
	call math.cos(cos_angle, angle)
	call math.muldiv(forward_part, cos_angle, pen_speed, 32767)
	call math.muldiv(side_part, sin_angle, pen_side, 32767)
	forward_part += side_part
	call math.muldiv(turn_part, sin_angle, pen_turn, 32767)
	left_rest += forward_part - turn_part
	right_rest += forward_part + turn_part
	left_speed = left_rest / 10
	right_speed = right_rest / 10
	left_rest -= left_speed * 10
	right_rest -= right_speed * 10
	motor.left.target = left_speed
	motor.right.target = right_speed
	heading_rest += (right_speed - left_speed) * 86
	turn_part = heading_rest / 49
	heading += turn_part
	heading_rest -= turn_part * 49
	pen_dir += pen_dir_step
	step_count -= 1
	timer.period[1] = 50
elseif pause_count > 0 then
	motor.left.target = 0
	motor.right.target = 0
	pause_count -= 1
	timer.period[1] = 50
elseif cloud_index < 18 then
	step_count = cloud_steps[cloud_index]
	pen_dir = cloud_steps[cloud_index + 1]
	pen_dir_step = cloud_steps[cloud_index + 2]
	cloud_index += 3
	pause_count = 6
	timer.period[1] = 50
else
	callsub resume_explore
end

onevent button.center
if button.center == 1 then
	if paused == 0 then
		paused = 1
		timer.period[1] = 0
		motor.left.target = 0
		motor.right.target = 0
		call leds.top(0, 0, 32)
	else
		paused = 0
		if front_peak >= front_hard or rear_peak >= rear_hard or edge_confirmed == 1 or (front_peak >= front_threshold and rear_peak >= rear_threshold) then
			callsub block_motion
		else
			callsub resume_explore
			if front_peak >= front_threshold then
				callsub start_maneuver
			end
		end
	end
end

onevent prox
seen_prox = 1
call math.stat(prox.horizontal[0:4], front_min, front_peak, front_mean)
call math.max(rear_peak, prox.horizontal[5:5], prox.horizontal[6:6])
# This is apparent closing rate in raw IR units, not object speed in mm/s.
# An initially repeated value lets the first few samples form a shorter window.
if trend_ready == 0 then
	front_rise = 0
	rear_rise = 0
	front_prev_1 = front_peak
	front_prev_2 = front_peak
	front_prev_3 = front_peak
	rear_prev_1 = rear_peak
	rear_prev_2 = rear_peak
	rear_prev_3 = rear_peak
	trend_ready = 1
else
	front_rise = front_peak - front_prev_3
	rear_rise = rear_peak - rear_prev_3
	front_prev_3 = front_prev_2
	front_prev_2 = front_prev_1
	front_prev_1 = front_peak
	rear_prev_3 = rear_prev_2
	rear_prev_2 = rear_prev_1
	rear_prev_1 = rear_peak
end
if state == 1 and (maneuver_active == 1 or (steer > -30 and steer < 30)) and front_peak >= front_threshold then
	if (maneuver_active == 0 and front_rise >= fast_rise) or (maneuver_active == 1 and front_rise >= maneuver_fast_rise) then
		if front_fast_hits < 2 then
			front_fast_hits += 1
		end
	else
		front_fast_hits = 0
	end
else
	front_fast_hits = 0
end
if state == 1 and maneuver_active == 0 and steer > -30 and steer < 30 and rear_peak >= rear_threshold and rear_rise >= fast_rise then
	if rear_fast_hits < 2 then
		rear_fast_hits += 1
	end
else
	rear_fast_hits = 0
end

if prox.ground.delta[0] <= white_min then
	if left_low < edge_samples then
		left_low += 1
	end
else
	left_low = 0
end
if prox.ground.delta[1] <= white_min then
	if right_low < edge_samples then
		right_low += 1
	end
else
	right_low = 0
end
edge_confirmed = 0
edge_fast = 0
if left_low >= edge_samples or right_low >= edge_samples then
	edge_confirmed = 1
end
if left_low >= fast_edge_samples or right_low >= fast_edge_samples then
	edge_fast = 1
end

if paused == 0 then
	if state == 3 then
		if avoid_phase == 4 then
			# Remain stopped until all directions are clear for three readings.
			if front_peak < front_clear and rear_peak < rear_clear and edge_fast == 0 then
				clear_samples += 1
				if clear_samples >= 3 then
					callsub resume_explore
				end
			else
				clear_samples = 0
			end
		elseif avoid_phase == 1 then
			if (avoid_kind == 1 and rear_peak >= rear_threshold) or (avoid_kind == 2 and (front_peak >= front_threshold or edge_fast == 1)) then
				callsub block_motion
			end
		elseif avoid_phase == 2 then
			if edge_fast == 1 then
				callsub block_motion
			end
		elseif avoid_phase == 3 then
			if front_peak >= front_threshold or edge_fast == 1 then
				callsub block_motion
			end
		end
	elseif edge_confirmed == 1 or front_peak >= front_hard or front_fast_hits >= 2 then
		if rear_peak >= rear_threshold then
			callsub block_motion
		else
			avoid_kind = 1
			callsub start_avoid
		end
	elseif rear_peak >= rear_hard or rear_fast_hits >= 2 then
		if front_peak >= front_clear or edge_fast == 1 then
			callsub block_motion
		else
			avoid_kind = 2
			callsub start_avoid
		end
	elseif front_peak >= front_threshold or maneuver_active == 1 then
		if maneuver_active == 0 then
			callsub start_maneuver
		else
			if front_peak < front_clear then
				maneuver_clear_samples += 1
				if maneuver_clear_samples >= 3 then
					callsub finish_maneuver
				end
			else
				maneuver_clear_samples = 0
			end
			if maneuver_active == 1 then
				callsub drive_to_empty_space
			end
		end
	elseif state == 1 then
		callsub drive_to_empty_space
	end
end

onevent timer0
if paused == 0 and state == 1 and seen_prox == 1 then
	explore_ticks += 1
	if explore_ticks % 20 == 0 then
		wander_sign = -wander_sign
	end
	if maneuver_active == 1 then
		maneuver_ticks += 1
		if maneuver_ticks >= maneuver_timeout_ticks then
			if front_peak < front_threshold then
				callsub finish_maneuver
			elseif rear_peak >= rear_threshold then
				callsub block_motion
			else
				avoid_kind = 1
				callsub start_avoid
			end
		end
	elseif explore_ticks >= explore_ticks_to_draw and front_peak < front_threshold and rear_peak < rear_threshold and edge_fast == 0 then
		callsub start_cloud
	end
end

onevent timer1
timer.period[1] = 0
if paused == 0 then
	if state == 2 then
		callsub cloud_step
	elseif state == 3 then
		if avoid_phase == 1 then
			wiggle_index += 1
			if wiggle_index < wiggle_steps then
				callsub start_wiggle_step
			elseif avoid_kind == 1 then
				if rear_peak >= rear_threshold or edge_confirmed == 1 then
					callsub block_motion
				else
					avoid_phase = 2
					motor.left.target = 500
					motor.right.target = -500
					timer.period[1] = turn_time
				end
			else
				callsub start_shot
			end
		elseif avoid_phase == 2 then
			callsub start_shot
		elseif avoid_phase == 3 then
			if front_peak >= front_clear or rear_peak >= rear_clear or edge_fast == 1 then
				callsub block_motion
			else
				callsub resume_explore
			end
		end
	end
end
]]></node>
</network>
